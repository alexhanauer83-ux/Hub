<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ab Android 13 nötig, damit Hub eigene Hinweise (z. B. Fehler eines Connectors)
         anzeigen darf. Nicht für das Mitlesen fremder Notifications - das regelt
         ausschliesslich der Notification-Listener-Zugriff unten. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase 6: ausschliesslich fuer die API-Connectoren (Telegram Bot API, IMAP).
         Die Verbindungen gehen direkt zum jeweiligen Dienst - es gibt kein Hub-Backend,
         keine Cloud-Synchronisierung und kein Analytics/Tracking. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 5, OPTIONAL: nur relevant, wenn der Nutzer Hub bewusst zur Standard-SMS-App
         macht. Ohne die Rolle bleiben diese Berechtigungen ungenutzt; READ_SMS/SEND_SMS
         werden zusaetzlich zur Laufzeit abgefragt.
         android:required="false" beim Telefonie-Feature, damit die App auch auf Geraeten
         ohne Mobilfunk (Tablets) installierbar bleibt. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />

    <!-- Fuer die Empfaengerauswahl beim SMS-Verfassen. Wird zur Laufzeit abgefragt und
         nur lokal zur Anzeige/Auswahl genutzt. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Selbst-Update: erlaubt Hub, die heruntergeladene Update-APK zu installieren.
         Android zeigt beim Installieren trotzdem einen Bestaetigungsdialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Seit Android 11 sind installierte Apps standardmaessig fuereinander unsichtbar
         (Package Visibility). Ohne diese Berechtigung schlaegt das Aufloesen von
         App-Name und -Icon zur Quell-App fehl, und im Hub steht nur der rohe
         Paketname (z.B. com.google.android.apps.photos statt "Google Fotos").
         Fuer einen Nachrichten-Hub, der ohnehin alle Benachrichtigungen buendelt, ist
         das gerechtfertigt; die Namen/Icons werden ausschliesslich lokal zur Anzeige
         genutzt und verlassen das Geraet nicht. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Phase 7: App-Lock. USE_BIOMETRIC deckt Fingerabdruck/Gesicht ab; die Geraete-PIN
         als Rueckfallebene braucht keine eigene Berechtigung. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- allowBackup=false ist hier eine bewusste Sicherheitsentscheidung, kein Versehen:
         Der Hub buendelt Nachrichteninhalte aller Apps. Wuerde Android sie ins Cloud-
         Backup schieben, waere die lokale Verschluesselung wertlos - die Daten laegen
         ausserhalb des Geraets. Das widerspricht der Zusage "bleibt lokal". -->
    <application
        android:name=".HubApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hub">

        <!-- Android Auto: deklariert Hub als Messaging-App (liest MessagingStyle-
             Benachrichtigungen vor + Sprachantwort). Siehe res/xml/automotive_app_desc.xml. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Empfaengt Antwort/Gelesen aus Hub-Benachrichtigungen (u.a. Auto-Sprachantwort).
             Nicht exported: Die PendingIntents stammen aus der App selbst. -->
        <receiver
            android:name=".notification.HubReplyReceiver"
            android:exported="false" />

        <!-- Teilt die heruntergeladene Update-APK sicher mit dem System-Installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Kernfunktion 1: Notification-Aggregation.
             - Die Signatur-Permission BIND_NOTIFICATION_LISTENER_SERVICE stellt sicher,
               dass ausschliesslich das System diesen Service binden darf.
             - exported=true ist Pflicht (Intent-Filter + Bindung von ausserhalb der App).
             - Die Berechtigung selbst kann nicht per Runtime-Dialog angefragt werden;
               der Nutzer erteilt sie in den Systemeinstellungen (siehe NotificationAccess). -->
        <service
            android:name=".notification.HubNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Phase 5: Die vier Pflichtkomponenten der Standard-SMS-App-Rolle. Android
             prueft ihr Vorhandensein, bevor es eine App ueberhaupt zur Auswahl anbietet -
             fehlt eine davon, erscheint Hub nicht in der Liste. Sie sind auch dann
             deklariert, wenn der Nutzer die Rolle nie aktiviert; ohne die Rolle stellt
             das System ihnen schlicht nie etwas zu. -->

        <!-- 1. Eingehende SMS: SMS_DELIVER geht ausschliesslich an die Standard-SMS-App. -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- 2. Eingehende MMS (nicht inhaltlich verarbeitet, siehe MmsReceiver-KDoc). -->
        <receiver
            android:name=".sms.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- 3. "Mit Nachricht antworten" aus dem Anrufbildschirm. -->
        <service
            android:name=".sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- 4. "Neue SMS schreiben"-Einstieg aus anderen Apps. -->
        <activity
            android:name=".sms.ComposeSmsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

    </application>

</manifest>
